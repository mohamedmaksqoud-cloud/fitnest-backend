# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./fitnest.db
# For Postgres (Render/Railway provide this automatically):
# DATABASE_URL=postgresql://user:password@host:5432/fitnest

# The email that automatically becomes admin on registration
ADMIN_EMAIL=mohmedmaksqoud@gmail.com

# --- SMTP (Gmail example: host=smtp.gmail.com port=587, use an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FitNest <you@gmail.com>
SMTP_TLS=true

# --- AI (FitCoach chat) ---
# Free key from https://aistudio.google.com/apikey
# The key stays in YOUR OWN .env / hosting env vars — never share it in chat.
GEMINI_API_KEY=

# --- CORS (comma-separated; * = allow all, fine for a mobile app) ---
CORS_ORIGINS=*

# App name used in emails
APP_NAME=FitNest
